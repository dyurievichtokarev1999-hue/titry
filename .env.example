# Скопируйте в .env и заполните. Файл .env не коммитится.

# Черновики титров через Claude. Без ключа используется заготовка без ИИ.
ANTHROPIC_API_KEY=
# Модель черновика (по умолчанию claude-opus-5-5)
TITRY_MODEL=claude-opus-5-5

# Telegram-бот: токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Качество ролика в боте: preview | standard | hd
BOT_PRESET=standard
# Подпись в углу ролика; пустая строка — без подписи
BOT_WATERMARK=сделано в титрах
# Соль для хэша id пользователей в метриках. Задайте длинную случайную строку и не меняйте.
METRICS_SALT=

# Голосовые: Yandex SpeechKit (API-ключ сервисного аккаунта и каталог)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Монтажная
PORT=4173

# Необязательно: свой путь к Chromium и ffmpeg
# TITRY_CHROMIUM=/opt/pw-browsers/chromium
# FFMPEG=/usr/bin/ffmpeg
