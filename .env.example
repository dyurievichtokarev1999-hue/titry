# Скопируйте в .env и заполните. Файл .env не коммитится.

# Черновики титров через Claude. Без ключа используется заготовка без ИИ.
ANTHROPIC_API_KEY=
# Модель черновика (по умолчанию claude-opus-5-5)
TITRY_MODEL=claude-opus-5-5

# Telegram-бот: токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Качество ролика в боте: preview | standard | hd
BOT_PRESET=standard
# Подпись в углу ролика; пустая строка — без подписи
BOT_WATERMARK=сделано в титрах
# Соль для хэша id пользователей в метриках — обязательна, не короче 16 знаков (без неё бот не запускается).
# Длинная случайная строка, например: openssl rand -hex 32. Не меняйте после запуска.
# Только для локальной разработки без бота: TITRY_DEV_METRICS=1 — случайная соль на процесс (удаление после
# перезапуска прежние строки не найдёт). Бот без METRICS_SALT не запускается и с этим флагом.
METRICS_SALT=

# Хранилище запретов по безопасности (server/ledger.js). Ключ обязателен: без него или с ключом короче 16 знаков
# бот и монтажная не запускаются. Длинная случайная строка, например: openssl rand -hex 32. Это секрет — не коммитьте.
TITRY_BLOCKED_HMAC_KEY=
# Версия ключа; пусто — v1. Не меняйте ключ и версию после запуска: с другими значениями прежний файл запретов
# не пройдёт проверку и бот с монтажной не запустятся (перехода на новый ключ нет).
TITRY_BLOCKED_KEY_VERSION=

# Голосовые: Yandex SpeechKit (API-ключ сервисного аккаунта и каталог)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Закрытый тест G0 (Б6): только участники из списка и пределы обращений к модели. Значения ниже — вымышленные примеры.
# При TITRY_RELEASE_REAL_DATA=1 закрытый режим обязателен; пустой или неверный список — отказ старта.
# TITRY_CLOSED_TEST=1
# TITRY_ALLOWED_CHATS=100000001,100000002
# TITRY_STORIES_PER_DAY=3
# TITRY_MODEL_CONCURRENCY=2
# TITRY_MODEL_WAIT_MS=30000

# Монтажная
PORT=4173

# Необязательно: свой путь к Chromium и ffmpeg
# TITRY_CHROMIUM=/opt/pw-browsers/chromium
# FFMPEG=/usr/bin/ffmpeg
